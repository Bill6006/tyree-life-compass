{
  "name": "tyree-life-compass",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && node scripts/icons.mjs && vite build && node scripts/seal-build.mjs",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "verify:artifact": "node scripts/verify-artifact.mjs",
    "verify:deployed": "node scripts/verify-artifact.mjs --url https://bill6006.github.io/tyree-life-compass/"
  },
  "dependencies": {
    "dexie": "4.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "fake-indexeddb": "6.2.5",
    "sharp": "0.35.4",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.0"
  }
}
